# =========================
# Maveric AI Configuration
# Copy to .env and fill in values. Do NOT commit .env.
# =========================

# JWT signing secret (required in production)
JWT_SECRET=

# =========================
# Database
# =========================
# Local default: sqlite:///./chat.db
# Production (optional): postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# =========================
# Ollama / AI
# =========================
# Local:  http://localhost:11434
# Cloud:  https://ollama.com
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Leave blank to auto-detect installed models (local Ollama).
# Set explicitly for production cloud models.
TEXT_MODEL=
VISION_MODEL=

# Request timeouts (seconds)
TEXT_TIMEOUT=60
VISION_TIMEOUT=300

# =========================
# CORS / Frontend
# =========================
# Single production frontend URL (e.g. https://your-app.pages.dev)
FRONTEND_URL=

# Comma-separated list overrides FRONTEND_URL when set
# Example: http://localhost:8080,https://your-app.pages.dev
ALLOWED_ORIGINS=

# =========================
# Gmail SMTP (forgot-password OTP)
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# =========================
# Optional
# =========================
DEBUG=false

# Tesseract OCR path (optional; auto-detected on most systems)
TESSERACT_CMD=
